# Leave VITE_API_BASE_URL empty to route API calls through the Vite dev
# proxy (see VITE_API_PROXY_TARGET) — this keeps requests same-origin so the
# session cookie set by the API survives. Set VITE_API_BASE_URL directly only
# when the app is served from the same origin as the API (e.g. production
# behind a shared reverse proxy).
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://192.168.110.52:8000
